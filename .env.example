# Copy this file to .env and fill in your real values. Never commit .env itself.

# --- Phase 0 (citizenship_score CLI) ---
LYFTA_API_KEY=your-lyfta-api-key-here

# --- Phase 1 (backend/) ---
# Direct (non-pooled) connection string to your Supabase project's Postgres,
# e.g. postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/citizenship

# Your Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Only needed if your Supabase project still uses the legacy shared JWT
# secret (Project Settings -> API -> JWT Settings). Projects migrated to
# JWT signing keys don't need this -- see backend/README.md.
SUPABASE_JWT_SECRET=

# Fernet key used to encrypt Lyfta credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=your-generated-fernet-key-here

# Set true only for local single-instance dev; see backend/README.md.
ENABLE_INPROCESS_SCHEDULER=false

# Optional, default shown. Overlap window subtracted from last_synced_at
# before each Lyfta sync.
LYFTA_SYNC_OVERLAP_DAYS=1
