# Copy to .env and fill in real values. Never commit .env itself.
# Expo inlines any EXPO_PUBLIC_* var into the JS bundle at build time --
# these are not secrets (the anon key is public by design; never put the
# Supabase secret/service_role key here).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your laptop's LAN IP + the backend's port -- NOT 127.0.0.1/localhost,
# since Expo Go on your phone is a separate device on the same Wi-Fi.
# See README "Running the backend on your LAN" for how to find this.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
